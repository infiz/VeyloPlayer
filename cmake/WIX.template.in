<?xml version="1.0" encoding="UTF-8"?>

<?include "cpack_variables.wxi"?>

<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"@CPACK_WIX_CUSTOM_XMLNS_EXPANDED@
    RequiredVersion="4.0">

    <Package
        Name="$(var.CPACK_PACKAGE_NAME)"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)"
        ProductCode="$(var.CPACK_WIX_PRODUCT_GUID)"
        Scope="$(var.CPACK_WIX_INSTALL_SCOPE)"
        InstallerVersion="500"
        Language="1033"
        Compressed="yes">

        <?ifndef CPACK_WIX_CAB_PER_COMPONENT?>
        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>
        <?endif?>

        <MajorUpgrade
            AllowSameVersionUpgrades="yes"
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."/>

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)"/>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT"/>
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch VeyloPlayer"/>
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico"/>
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)"/>
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)"/>
        <?endif?>

        <FeatureRef Id="ProductFeature">
            <ComponentRef Id="VeyloFileAssociations"/>
        </FeatureRef>

        <Component
            Id="VeyloFileAssociations"
            Directory="INSTALL_ROOT"
            Guid="7D8DFE93-843E-47EF-8C32-C37D7B87ACF5"
            Bitness="always64">
            <RegistryValue Root="HKLM" Key="Software\RegisteredApplications"
                Name="VeyloPlayer" Type="string" Value="Software\VeyloPlayer\Capabilities"
                KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities"
                Name="ApplicationName" Type="string" Value="VeyloPlayer"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities"
                Name="ApplicationDescription" Type="string" Value="A modern open-source media player"/>

            <RegistryValue Root="HKLM" Key="Software\Classes\VeyloPlayer.Media"
                Type="string" Value="VeyloPlayer media file"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\VeyloPlayer.Media\DefaultIcon"
                Type="string" Value="&quot;[#CM_FP_bin.VeyloPlayer.exe]&quot;,0"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\VeyloPlayer.Media\shell\open\command"
                Type="string" Value="&quot;[#CM_FP_bin.VeyloPlayer.exe]&quot; &quot;%1&quot;"/>

            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe"
                Name="FriendlyAppName" Type="string" Value="VeyloPlayer"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe"
                Name="ApplicationIcon" Type="string" Value="&quot;[#CM_FP_bin.VeyloPlayer.exe]&quot;,0"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\shell\open\command"
                Type="string" Value="&quot;[#CM_FP_bin.VeyloPlayer.exe]&quot; &quot;%1&quot;"/>
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\VeyloPlayer.exe"
                Type="string" Value="[#CM_FP_bin.VeyloPlayer.exe]"/>

            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".mp3" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".m4a" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".aac" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".wav" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".flac" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".ogg" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".mp4" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".m4v" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".mov" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".mkv" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".webm" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".avi" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".jpg" Type="string" Value="VeyloPlayer.Media"/>
            <RegistryValue Root="HKLM" Key="Software\VeyloPlayer\Capabilities\FileAssociations" Name=".jpeg" Type="string" Value="VeyloPlayer.Media"/>

            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".mp3" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".m4a" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".aac" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".wav" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".flac" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".ogg" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".mp4" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".m4v" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".mov" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".mkv" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".webm" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".avi" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".jpg" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\VeyloPlayer.exe\SupportedTypes" Name=".jpeg" Type="string" Value=""/>

            <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.m4a\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.aac\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.ogg\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.mp4\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.m4v\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.mov\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.mkv\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.webm\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.avi\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.jpg\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
            <RegistryValue Root="HKLM" Key="Software\Classes\.jpeg\OpenWithProgids" Name="VeyloPlayer.Media" Type="string" Value=""/>
        </Component>

        <ui:WixUI Id="$(var.CPACK_WIX_UI_REF)"/>
        <UIRef Id="WixUI_ErrorProgressText"/>
        <UI>
            <Publish
                Dialog="ExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="LaunchVeyloPlayer"
                Order="1"
                Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed"/>
        </UI>

        <CustomAction
            Id="LaunchVeyloPlayer"
            FileRef="CM_FP_bin.VeyloPlayer.exe"
            ExeCommand=""
            Execute="immediate"
            Impersonate="yes"
            Return="asyncNoWait"/>

        <?include "properties.wxi"?>
        <?include "product_fragment.wxi"?>
    </Package>
</Wix>
