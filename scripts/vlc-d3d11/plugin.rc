#include <winver.h>

// The fourth field is the VeyloPlayer patch revision. Keep it newer than the
// stock VLC DLL so Windows Installer replaces the versioned upstream file.
1 VERSIONINFO
FILEVERSION 3,0,24,1
PRODUCTVERSION 3,0,24,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VLC Direct3D 11 output with VeyloPlayer planar 4:2:2 support"
            VALUE "FileVersion", "3.0.24.1"
            VALUE "InternalName", "direct3d11"
            VALUE "OriginalFilename", "libdirect3d11_plugin.dll"
            VALUE "ProductName", "VLC media player"
            VALUE "ProductVersion", "3.0.24"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
